# ==============================================================================
# EduVerse AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   copy .env.example .env
#
# NOTE: All settings have sensible defaults. Hand-editing this file is completely
# OPTIONAL. Settings can also be configured directly via the web UI Settings page.
# ==============================================================================

# --- Server & Directory Binding ---
QUICKLEARN_HOST=127.0.0.1
QUICKLEARN_PORT=8080
# Explicit storage path (default: ./data)
# QUICKLEARN_DATA_DIR=./data

# --- Security & JWT Authentication ---
# In production, replace with a secure random 32-character string.
# In development, a persistent machine-keyed salt is auto-generated if omitted.
QUICKLEARN_JWT_SECRET=eduverse_dev_secret_key_change_in_production_2026

# --- Primary AI Provider Routing ---
# Default: ollama (100% private, zero external API costs, RTX 3050 GPU offload)
# Routing Tiers: Local Ollama (Primary) -> Cloud Fallback (Disabled by default) -> Local Mock
LLM_PROVIDER=ollama

# [Primary Tier: Local LLM via Ollama with Native Reasoning]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Reasoning thinking level: high | medium | low | off
OLLAMA_THINK=high
# Context window: 4096 tokens (optimal for 6GB RTX 3050 VRAM; expandable to 8192)
OLLAMA_NUM_CTX=4096
# Keep model in GPU VRAM (default: 10m)
OLLAMA_KEEP_ALIVE=10m
# Privacy Guard: Block all external cloud model routing unless explicitly permitted
ALLOW_CLOUD_FALLBACK=false

# [Secondary Tier: Optional Cloud LLMs — Only active if ALLOW_CLOUD_FALLBACK=true]
# Google Gemini (Gemini 2.5/3.8 Flash, Vision OCR)
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_MODEL=gemini-2.5-flash

# Groq (Ultra-fast cloud LLaMA 3.3 70B)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Cloud
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet

# [Tertiary Tier: Local Mock Mode]
# If Ollama is offline and ALLOW_CLOUD_FALLBACK=false, EduVerse gracefully operates
# in offline deterministic mock mode citing real document excerpts without crashing.

# --- Educational Engine Parameters ---
FSRS_DESIRED_RETENTION=0.90
RAG_TOP_K=10
QUIZ_DEFAULT_MCQ_OPTIONS=4
