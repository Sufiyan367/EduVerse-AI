# EduVerse AI Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "openrouter", "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (Required if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Selection
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DOC_CHARS=50000
